<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <entry name="launchers" type="StringList"><label>Existing pinned launcher URLs, in order</label><default></default></entry>
    <entry name="iconSize" type="Int"><default>60</default><min>24</min><max>64</max></entry>
    <entry name="zoomFactor" type="Double"><default>1.55</default><min>1.0</min><max>2.0</max></entry>
    <entry name="showDownloads" type="Bool"><default>false</default></entry>
    <entry name="showTrash" type="Bool"><default>true</default></entry>
    <entry name="showRunningDots" type="Bool"><default>false</default></entry>
    <entry name="utilityLaunchers" type="StringList"><default>applications:systemsettings.desktop</default></entry>
  </group>
</kcfg>
