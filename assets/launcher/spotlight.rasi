/* Spotlight-style launcher (rofi). Source: Figma macOS 26 kit, Search Field (120 x 24 pt)
   on the 1512 x 982 pt frame. Every value below is a placeholder that lib/launcher.py fills
   with the pixels for the user's screen: each Figma size is a percentage of the frame,
   so widths and horizontal padding scale with screen width, heights, radius and font with
   screen height. */
configuration {
    modi: "drun";
    show-icons: true;
    icon-theme: "@ICON_THEME@";
    drun-display-format: "{name}";
    display-drun: "";
    font: "@FONT_UI@ @SPOT_FONT_PT@";
    hover-select: true;
    click-to-exit: true;
}

* {
    background-color: transparent;
    text-color: #f5f5f5;
}

window {
    location: north;
    anchor: north;
    width: @SPOT_WIDTH@px;
    y-offset: 22%;
    border: 1px;
    border-radius: @SPOT_RADIUS@px;
    border-color: rgba(255, 255, 255, 18%);
    background-color: rgba(40, 40, 44, 96%);
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 0px;
}

inputbar {
    children: [ icon-search, entry ];
    padding: @SPOT_PAD_V@px @SPOT_PAD_R@px @SPOT_PAD_V@px @SPOT_PAD_L@px;
    spacing: @SPOT_GAP@px;
    border: 0px 0px 1px 0px;
    border-color: rgba(255, 255, 255, 10%);
}

icon-search {
    expand: false;
    filename: "system-search-symbolic";
    size: @SPOT_ICON@px;
    vertical-align: 0.5;
}

entry {
    placeholder: "Spotlight Search";
    placeholder-color: rgba(255, 255, 255, 45%);
    font: "@FONT_UI@ @SPOT_FONT_PT@";
    vertical-align: 0.5;
    cursor: text;
}

listview {
    lines: 7;
    fixed-height: false;
    scrollbar: false;
    padding: 6px;
    spacing: 2px;
}

element {
    padding: 7px 12px;
    spacing: 12px;
    border-radius: 8px;
    cursor: pointer;
}

element selected.normal {
    background-color: @ACCENT@;
    text-color: #ffffff;
}

element-text selected {
    text-color: #ffffff;
}

element-icon {
    size: 30px;
    vertical-align: 0.5;
    cursor: inherit;
}

element-text {
    vertical-align: 0.5;
    cursor: inherit;
}
