/* Spotlight-style launcher (rofi). Source: Figma macOS 26 kit, Search Field component (120 x 24 px).
   All metrics as a percentage of that field:
     corner radius      6 px  = 25 % of its height
     left padding       8 px  = 6.7 % of its width
     right padding      4 px  = 3.3 % of its width
     icon gap           2 px  = 1.7 % of its width
     magnifying glass  16 px  = 66.7 % of its height (16 x 15 in Figma)
     text               13 px = 54 % of its height (SF 13 px, here Inter 10 pt)
   The values below are the px equivalents of those percentages at the Figma size. */
configuration {
    modi: "drun";
    show-icons: true;
    icon-theme: "@ICON_THEME@";
    drun-display-format: "{name}";
    display-drun: "";
    font: "@FONT_UI@ 10";
    hover-select: true;
    click-to-exit: true;
}

* {
    background-color: transparent;
    text-color: #f5f5f5;
}

window {
    location: north;
    anchor: north;
    y-offset: 22%;
    border: 1px;
    border-radius: 6px;
    border-color: rgba(255, 255, 255, 18%);
    background-color: rgba(40, 40, 44, 96%);
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 0px;
}

inputbar {
    children: [ icon-search, entry ];
    padding: 4px 8px 4px 8px;
    spacing: 2px;
    border: 0px 0px 1px 0px;
    border-color: rgba(255, 255, 255, 10%);
}

icon-search {
    expand: false;
    filename: "system-search-symbolic";
    size: 16px;
    vertical-align: 0.5;
}

entry {
    placeholder: "Spotlight Search";
    placeholder-color: rgba(255, 255, 255, 45%);
    font: "@FONT_UI@ 10";
    vertical-align: 0.5;
    cursor: text;
}

listview {
    lines: 7;
    fixed-height: false;
    scrollbar: false;
    padding: 6px;
    spacing: 2px;
}

element {
    padding: 7px 12px;
    spacing: 12px;
    border-radius: 8px;
    cursor: pointer;
}

element selected.normal {
    background-color: @ACCENT@;
    text-color: #ffffff;
}

element-text selected {
    text-color: #ffffff;
}

element-icon {
    size: 30px;
    vertical-align: 0.5;
    cursor: inherit;
}

element-text {
    vertical-align: 0.5;
    cursor: inherit;
}
