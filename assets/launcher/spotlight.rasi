/* Spotlight-style launcher (rofi). Sizes come from the Figma macOS 26 kit only:
   Search Field: 6 px radius, 8 px left / 4 px right padding, 2 px icon gap,
   16 px magnifying glass, SF text 13 px (= Inter 10 pt). Colours follow the dark theme. */
configuration {
    modi: "drun";
    show-icons: true;
    icon-theme: "@ICON_THEME@";
    drun-display-format: "{name}";
    display-drun: "";
    font: "@FONT_UI@ 10";
    hover-select: true;
    click-to-exit: true;
}

* {
    background-color: transparent;
    text-color: #f5f5f5;
}

window {
    location: north;
    anchor: north;
    y-offset: 22%;
    border: 1px;
    border-radius: 6px;
    border-color: rgba(255, 255, 255, 18%);
    background-color: rgba(40, 40, 44, 96%);
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 0px;
}

inputbar {
    children: [ icon-search, entry ];
    padding: 4px 8px 4px 8px;
    spacing: 2px;
    border: 0px 0px 1px 0px;
    border-color: rgba(255, 255, 255, 10%);
}

icon-search {
    expand: false;
    filename: "system-search-symbolic";
    size: 16px;
    vertical-align: 0.5;
}

entry {
    placeholder: "Spotlight Search";
    placeholder-color: rgba(255, 255, 255, 45%);
    font: "@FONT_UI@ 10";
    vertical-align: 0.5;
    cursor: text;
}

listview {
    lines: 7;
    fixed-height: false;
    scrollbar: false;
    padding: 6px;
    spacing: 2px;
}

element {
    padding: 7px 12px;
    spacing: 12px;
    border-radius: 8px;
    cursor: pointer;
}

element selected.normal {
    background-color: @ACCENT@;
    text-color: #ffffff;
}

element-text selected {
    text-color: #ffffff;
}

element-icon {
    size: 30px;
    vertical-align: 0.5;
    cursor: inherit;
}

element-text {
    vertical-align: 0.5;
    cursor: inherit;
}
