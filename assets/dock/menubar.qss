/* Figma menu-bar items : 24px pills, 11px side padding, radius 4, items touch (no gap) */
StatusNotifierButton {
    min-height: 24px; max-height: 24px;
    min-width: 35px; max-width: 35px;   /* + the plugin's 3px spacing = 38px pitch */
    padding: 0px;
    margin: 0px; border: none; border-radius: 4px;
}
VolumeButton, Button, #Mount QToolButton {
    min-height: 24px; max-height: 24px;
    min-width: 38px; max-width: 38px;
    padding: 0px;
    margin: 0px; border: none; border-radius: 4px;
}
StatusNotifierButton:hover, VolumeButton:hover, Button:hover, #Mount QToolButton:hover { background: rgba(255, 255, 255, 10%); }
StatusNotifierButton:pressed, VolumeButton:pressed, Button:pressed, #Mount QToolButton:pressed { background: rgba(255, 255, 255, 16%); }

/* clock: 13px semibold, pure white, same 11px padding */
LXQtWorldClock, #WorldClock { min-height: 24px; max-height: 24px; margin: 0px; border: none; border-radius: 4px; }
ActiveLabel { padding: 0px 11px; color: #ffffff; }
LXQtWorldClock:hover, #WorldClock:hover { background: rgba(255, 255, 255, 10%); }

/* Figma menu bar: 10px margin at both ends  */
LXQtPanel #BackgroundWidget { padding-left: 10px; padding-right: 10px; }

/* hidden-items expander: chevron instead of "+" (Thaw/Ice style) */
StatusNotifierWidget > QToolButton {
    qproperty-text: "‹";
    font-size: 20px;
    font-weight: 300;
    color: rgba(255, 255, 255, 85%);
}
