/* Figma dock: 36px icons, 9px gap, no hover pill (golden-gate-lxqt-theme) */
#QuickLaunch QToolButton {
    padding: 0px;
    margin: 0px 4px;
    border: none;
    border-radius: 8px;
    background: transparent;
}
#QuickLaunch QToolButton:hover, #QuickLaunch QToolButton:pressed { background: transparent; }
