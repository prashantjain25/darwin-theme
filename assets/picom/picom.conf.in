backend = "glx";
vsync = true;
xrender-sync-fence = true;
corner-radius = @WIN_R@;

rounded-corners-exclude = [
  "window_type = 'dock' && height = @BAR_H@",
  "window_type = 'desktop'",
  "class_g = 'lxqt-panel' && height = @BAR_H@",
  "class_g = 'Polybar'",
  "class_g = 'Plank'",
  "_NET_WM_STATE@[0]:a = '_NET_WM_STATE_FULLSCREEN'"
];

shadow = true;
shadow-radius = 48;

# --- Figma dark: glass, shadows, radii (golden-gate-lxqt-theme) ---
shadow-opacity = 0.35;
shadow-offset-x = 0;
shadow-offset-y = 16;
shadow-exclude = [
  "window_type = 'popup_menu'",
  "window_type = 'dropdown_menu'",
  "window_type = 'menu'",
  "window_type = 'tooltip'",
  "window_type = 'combo'",
  "window_type = 'dock'",
  "window_type = 'desktop'",
  "class_g = 'lxqt-panel'",
  "class_g = 'Plank'",
  "_GTK_FRAME_EXTENTS@:c"
];
blur-method = "dual_kawase";
blur-strength = 6;
blur-background-exclude = [ "window_type = 'desktop'"@DOCK_BLUR_EXCLUDE@ ];
opacity-rule = [
  "100:class_g = 'Google-chrome'",
  "92:window_type = 'tooltip'",
  "@SWITCHER_OPACITY@:class_g = 'OPENBOX_FOCUS_CYCLE_POPUP'"
];
corner-radius-rules = [
  "15:window_type = 'dock' && height = @DOCK_H@",
  "16:window_type = 'utility'",
  "@MENU_R@:window_type = 'popup_menu'",
  "@MENU_R@:window_type = 'dropdown_menu'",
  "@MENU_R@:window_type = 'menu'",
  "1:window_type = 'tooltip'",
  "@SWITCHER_R@:class_g = 'OPENBOX_FOCUS_CYCLE_POPUP'"
];
