backend = "glx";
vsync = true;
xrender-sync-fence = true;
force-win-blend = true;
shadow-radius = 48;
shadow-opacity = 0.35;
shadow-offset-x = 0;
shadow-offset-y = 16;
blur-method = "dual_kawase";
blur-strength = 6;
blur-background-fixed = true;

# Picom 12 window rules: keep foreground opacity separate from surface alpha.
rules = (
  { corner-radius = @WIN_R@; shadow = true; blur-background = true; },
  { match = "window_type = 'desktop'"; corner-radius = 0; shadow = false; blur-background = false; },
  { match = "window_type = 'dock' || window_type = 'popup_menu' || window_type = 'dropdown_menu' || window_type = 'menu' || window_type = 'tooltip' || window_type = 'combo' || class_g = 'lxqt-panel' || class_g = 'Plank' || _GTK_FRAME_EXTENTS"; shadow = false; },
  { match = "window_type = 'utility'"; corner-radius = 16; },
  { match = "window_type = 'popup_menu' || window_type = 'dropdown_menu' || window_type = 'menu'"; corner-radius = @MENU_R@; blur-background = false; },
  { match = "window_type = 'tooltip'"; corner-radius = 1; opacity = 0.92; },
  { match = "class_g = 'Polybar' || class_g = 'Plank' || (class_g = 'lxqt-panel' && height = @BAR_H@)"; corner-radius = 0; },
  { match = "class_g = 'Google-chrome'"; opacity = 1.0; },
  { match = "class_g = 'OPENBOX_FOCUS_CYCLE_POPUP'"; corner-radius = @SWITCHER_R@; opacity = @SWITCHER_ALPHA@; },
  { match = "class_i = 'GoldenGateSwitcher'"; corner-radius = @SWITCHER_R@; opacity = 1.0; shadow = false; },
  { match = "class_g = 'lxqt-panel' && height = @DOCK_H@"; corner-radius = 15; opacity = 1.0; blur-background = @DOCK_BLUR_BOOL@; },
  { match = "class_g = 'Plank'"; blur-background = false; },
  { match = "fullscreen"; corner-radius = 0; }
);
